# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# enable ctrl+backspace deleting words: outside tmux, Ghostty sends
# ctrl+backspace as ^H (0x08), and readline binds the terminal's werase
# character to unix-word-rubout. Inside tmux the key arrives as the CSI-u
# sequence \e[127;5u instead, which ~/.inputrc (programs.readline in
# nix/home.nix) handles.
stty werase \^H

source $HOME/etc/shell/path_setup

# Keep distinct from zsh history so they don't corrupt one another.
export HISTFILE=~/.bash_history

# Avoid duplicates
export HISTCONTROL=ignoredups:erasedups
# When the shell exits, append to the history file instead of overwriting it
shopt -s histappend

# After each command, append to the history file and reread it
# No, this was too dangerous, kept executing old commands from other terminals!
#export PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a; history -c; history -r"

if [[ ! "$PROMPT_COMMAND" =~ "history -a;" ]]; then
    export PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a;"
fi

# not sure why use of this gets injected, only seems to happen in gnome
if [ "$INSIDE_EMACS" ] && [[ "$PROMPT_COMMAND" =~ "__vte_prompt_command" ]]; then
    __vte_prompt_command() { true; }
fi

alias ag='ag --hidden'

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=10000000
HISTFILESIZE=20000000

# Enable automatic debug symbol downloading on ubuntu
if [ -f /etc/lsb-release ] && grep "Ubuntu" /etc/lsb-release > /dev/null; then
   export DEBUGINFOD_URLS="https://debuginfod.ubuntu.com"
fi

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# commented this out because gentoo prefix doesn't like it
# make less more friendly for non-text input files, see lesspipe(1)
#[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color|xterm-kitty|xterm-ghostty) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

if [ -f /etc/bashrc ]; then
   source /etc/bashrc
fi

if [ -f "$HOME/.cargo/env" ]; then
   source "$HOME/.cargo/env"
fi

if [ -f $HOME/.nix-profile/etc/profile.d/hm-session-vars.sh ]; then
   source $HOME/.nix-profile/etc/profile.d/hm-session-vars.sh
elif [ -f /etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh ]; then
    source /etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh
fi

eval "$(direnv hook bash)"

# Keep coding agents and all of their local child processes inside the shared
# aggregate resource limits configured by Home Manager's agents.slice.
alias antigravity='$HOME/etc/shell/agent_run.sh antigravity'

# The TUI agents also get the terminal restored when they exit unsuccessfully.
# A crash or a SIGKILL from agents.slice's OOM policy can skip their own
# cleanup and leave raw mode, mouse reporting, the alternate screen, etc.
# enabled. Under tmux, reset turns those modes off but stays on the alternate
# screen, so rmcup leaves it afterwards; for an agent that drew on the normal
# screen, reset clears it (tmux's scroll-on-clear moves it into history), so
# say why. Restoring the termios settings saved before launch keeps
# customizations like werase above, which stty sane would revert.
_agent_tui() {
    # Runs with stdin or stdout redirected (e.g. claude -p ... | jq) aren't TUI
    # sessions, so don't clear away their error output.
    if [[ ! -t 0 || ! -t 1 ]]; then
        "$HOME/etc/shell/agent_run.sh" "$@"
        return
    fi
    local tty_settings status signal
    tty_settings=$(stty -g)
    "$HOME/etc/shell/agent_run.sh" "$@"
    status=$?
    # Any non-zero status, not just 128+N signal deaths: even status 1 can be
    # a real crash, because JS runtimes such as Node exit with 1 on an
    # uncaught exception (and Rust exits with 101 on a panic).
    if (( status != 0 )); then
        reset
        tput rmcup
        stty "$tty_settings"
        local reason="status $status"
        # kill -l maps a 128+N status to signal N's name, and fails for
        # statuses past the last signal number, which can't be signal deaths.
        if (( status > 128 )) && signal=$(kill -l "$status" 2>/dev/null); then
            reason+=" (SIG$signal)"
        fi
        printf '%s exited with %s; terminal reset\n' "$1" "$reason" >&2
    fi
    return "$status"
}
claude() { _agent_tui claude "$@"; }
codex() { _agent_tui codex "$@"; }
gemini() { _agent_tui gemini "$@"; }
opencode() { _agent_tui opencode "$@"; }
pi() { _agent_tui pi "$@"; }

# start a tmux session if there isn't one, otherwise
# create a new session that is grouped with it, also
# cleanup sessions as terminals are closed, except that
# we want the last session to stay alive so we get the
# usual tmux behavior of keeping all our work running.
#
# Opening a terminal locally is usually for new work, so it gets a fresh
# window. Logging in over ssh (e.g. from the phone) is usually to check on
# existing work, so it goes to the window last looked at, which hooks in
# tmux.conf record. sshd sets SSH_CONNECTION, which is how we tell them apart.
t() {
    if [[ -n ${SSH_CONNECTION-} ]]; then
        # run-shell -C because select-window doesn't expand formats in -t
        tmux new-session -t work \; set-option destroy-unattached keep-last \; run-shell -C "select-window -t '#{@last_window}'"
    else
        # a brand new group already comes with a fresh window
        tmux new-session -t work \; set-option destroy-unattached keep-last \; if-shell -F '#{>:#{session_group_size},1}' new-window
    fi
}

# $- contains 'i' for interactive shells; -t 0 and -t 1 check that stdin
# and stdout are terminals. TMUX must be empty to prevent shells started
# inside tmux from recursively launching another tmux session.
if [[ $- == *i* && -t 0 && -t 1 && -z ${TMUX-} ]]; then
    t
fi